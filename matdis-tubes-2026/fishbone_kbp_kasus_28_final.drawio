<mxfile host="app.diagrams.net">
  <diagram name="Fishbone-6M-KBP-Kasus28-Final" id="fishbone-kbp-28-final">
    <mxGraphModel dx="2560" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1220" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_box" value="&lt;b&gt;DIAGRAM FISHBONE 6M: LANDASAN PEMODELAN GRAF KASUS 28 (SISKAMLING PORTAL)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#475569;&quot;&gt;Studi Kasus Zona Inti Kota Baru Parahyangan (KBP, 26 Node) — Acuan Node (V), Edge (E), Weight (w), &amp;amp; Dynamic MST&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="220" y="22" width="1810" height="64" as="geometry" />
        </mxCell>
        <mxCell id="main_spine" style="endArrow=classic;html=1;strokeWidth=5;strokeColor=#1E293B;endSize=10;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="630" as="sourcePoint" />
            <mxPoint x="2030" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fish_head" value="&lt;b style=&quot;font-size: 16px; color: #991B1B;&quot;&gt;MASALAH UTAMA:&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border:0.5px solid #DC2626;&quot;&gt;&lt;b&gt;Disrupsi konektivitas MST Zona Inti KBP (26 Node) pada jam malam&lt;/b&gt; akibat penutupan &lt;b&gt;2 Gate Sekunder (23.00–05.00 WIB)&lt;/b&gt;:&lt;br&gt;• &lt;b&gt;Gate 1 (e&lt;sub&gt;G1&lt;/sub&gt;, Barat):&lt;/b&gt; ruas Kancahnangkub Utara ↔ simpang Jl. Kancahnangkub Kidul&lt;br&gt;• &lt;b&gt;Gate 2 (e&lt;sub&gt;G2&lt;/sub&gt;, Timur):&lt;/b&gt; ruas tembus tikungan Jl. Gelap Nyawang (Bumi Pancasona) ↔ sudut barat laut Tatar Jingga&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; background-color: #FEE2E2; color: #991B1B;&quot;&gt;&lt;b&gt;Tuntutan MST:&lt;/b&gt; G' = G − {e&lt;sub&gt;G1&lt;/sub&gt;, e&lt;sub&gt;G2&lt;/sub&gt;}. Penutupan e&lt;sub&gt;G1&lt;/sub&gt;, e&lt;sub&gt;G2&lt;/sub&gt; ∈ T&lt;sub&gt;siang&lt;/sub&gt; memutus jalur dari Pos Komando Utara (&lt;b&gt;Node 0&lt;/b&gt;) dan memecah MST menjadi &lt;b&gt;3 komponen (19 + 6 + 1 node)&lt;/b&gt; → sambung ulang via sisi pengganti termurah (&lt;b&gt;Dynamic Subtree Repair&lt;/b&gt; vs. &lt;b&gt;Kruskal ulang&lt;/b&gt;).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontColor=#1E293B;fontSize=13.5;shadow=1;spacing=10;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2050" y="430" width="445" height="395" as="geometry" />
        </mxCell>
        <mxCell id="note_box" value="&lt;b&gt;Catatan Ruang Lingkup Pemodelan:&lt;/b&gt; MST murni hanya menggunakan &lt;b&gt;(V, E, w)&lt;/b&gt;. Faktor kapasitas jaringan (fiber/wireless), catu daya, beban radio HT, verifikasi tamu, cuaca, dan waktu tempuh (konsep &lt;i&gt;shortest path&lt;/i&gt;) &lt;b&gt;tidak dimodelkan&lt;/b&gt; sebagai bobot graf sehingga dikeluarkan dari fishbone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;dashed=1;fontColor=#334155;fontSize=13;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1">
